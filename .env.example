MC_DATABASE_URL=sqlite:////var/lib/mc-manager/mc-manager.db
MC_AUTO_CREATE_SCHEMA=false
MC_STORAGE_ROOT=/srv/mc-manager
MC_PORT_MIN=30000
MC_PORT_MAX=30099
# 可选：公网 FRP 端口池首端口；本地端口按相同偏移映射。
# MC_PUBLIC_GAME_HOST=example.com
# MC_PUBLIC_GAME_PORT_MIN=30000
MC_BACKUP_LIMIT=10
MC_RUNTIME_BACKEND=podman
MC_PODMAN_BINARY=/usr/bin/podman
MC_CONTAINER_PULL_TIMEOUT_SECONDS=900
MC_API_TOKEN=replace-with-a-long-random-secret
MC_API_HOST=127.0.0.1
MC_API_PORT=8080
MC_LOG_LEVEL=INFO
MC_WORKER_POLL_SECONDS=1.0
MC_TASK_LEASE_SECONDS=120
MC_START_TIMEOUT_SECONDS=180
MC_PAPERMC_USER_AGENT="mc-minigame-manager/0.2.0 (ops@example.com)"
MC_ALLOW_UNSTABLE_PAPER=false
MC_PAPER_ALLOWED_HOSTS=fill.papermc.io,fill-data.papermc.io
MC_MAX_ARTIFACT_BYTES=536870912
# 所有游戏启动前自动授予 4 级 OP；键为 Java 玩家名，值为正版 UUID。
MC_DEFAULT_OPERATORS_JSON={}
MC_MAX_UPLOAD_BYTES=2147483648
MC_MAX_UPLOAD_OVERHEAD_BYTES=16777216
MC_MAX_UPLOAD_SESSIONS=8
MC_MAX_UPLOAD_RESERVED_BYTES=8589934592
# 例如 https://example.com:你的HTTPS代理端口；该端口必须先终止 TLS，再转发到本机 8080。
MC_RESOURCE_PACK_BASE_URL=
MC_MAX_RESOURCE_PACK_BYTES=262144000
MC_MAX_EXTRACTED_BYTES=8589934592
MC_MAX_ARCHIVE_FILES=100000
MC_MAX_SINGLE_FILE_BYTES=2147483648
MC_MAX_COMPRESSION_RATIO=200
MC_JAVA_IMAGES_JSON={"8":"eclipse-temurin:8-jre","11":"eclipse-temurin:11-jre","16":"eclipse-temurin:16-jre","17":"eclipse-temurin:17-jre","21":"eclipse-temurin:21-jre","25":"eclipse-temurin:25-jre"}
